#!/usr/bin/env bash
# auto-context 공통 hook 디스패처.
# usage: run-hook <action> <engine> [--sandbox]
#   action: recall | update | update-queued | posttool | index | compile | gate
#   file-change-event
#   engine: claude | codex | gemini
# 모든 action은 이벤트 cwd의 Laya route를 먼저 분류한다. 선택된 route만
# core/laya_host_response.py가 처리하고, route가 없는 프로젝트는 아무 색인
# 작업도 하지 않는다(SessionStart에서만 온보딩 안내 한 줄).
set -u

ACTION="${1:-}"
ENGINE="${2:-claude}"

# 인자 없이 호출 시 usage 안내
if [ -z "$ACTION" ]; then
  echo "usage: run-hook <recall|update|update-queued|posttool|index|compile|gate|file-change-event> <claude|codex|gemini>" >&2
  exit 1
fi

# Sandbox and headless guards precede plugin-root files and all hook work.
_qmd_sandbox=0
case " $* " in *" --sandbox "*) _qmd_sandbox=1 ;; esac
[ -n "${QMD_SANDBOX:-}" ] && _qmd_sandbox=1
case "$ENGINE" in
  claude) { [ "${CLAUDE_HEADLESS:-}" = "1" ] || [ -n "${CLAUDE_SANDBOX:-}" ]; } && _qmd_sandbox=1 ;;
  # Normal Codex workspace-write runs set CODEX_SANDBOX; the selected-project
  # edit gate must still answer there. Nested extractor isolation is QMD_SANDBOX.
  codex)  [ -n "${CODEX_SANDBOX:-}" ] && [ "$ACTION" != "gate" ] && _qmd_sandbox=1 ;;
  gemini) [ -n "${GEMINI_SANDBOX:-}" ] && _qmd_sandbox=1 ;;
esac
if [ "$_qmd_sandbox" = 1 ]; then
  exit 0
fi

case "$ACTION" in
  recall|update|update-queued|gate|posttool|index|compile|file-change-event) ;;
  *) echo "run-hook: unknown action '$ACTION'" >&2; exit 1 ;;
esac

# The installed plugin is re-attested as an exact commit during setup. Python
# imports from this writable host cache must never add __pycache__ files.
export PYTHONDONTWRITEBYTECODE=1

_qmd_code_root="$(cd "$(dirname "$0")/.." && pwd)" || exit 0

# A route record is sticky. Classify the event's own cwd first; a selected
# route enters only the installer-verified Laya service.
_laya_route_payload="$(mktemp "${TMPDIR:-/tmp}/laya-route-payload.XXXXXXXX")" || { echo '[memvane] route lookup unavailable' >&2; exit 3; }
trap 'rm -f "$_laya_route_payload"' EXIT
cat >"$_laya_route_payload" || { echo '[memvane] route payload unavailable' >&2; exit 3; }
_laya_route_fallback="$PWD"
_laya_route_state="$(python3 "$_qmd_code_root/core/laya_index_host_route.py" classify-hook "$ACTION" "$_laya_route_payload" "$_laya_route_fallback")" || _laya_route_state=blocked
case "$_laya_route_state" in
  legacy)
    # No selected route: the project is not onboarded and gets no index,
    # recall, compile or learning work. SessionStart names onboarding once.
    if [ "$ACTION" = "update-queued" ]; then
      # A fresh installed SessionStart may acknowledge an owner-requested
      # history cutover. It never selects history or touches project content.
      python3 "$_qmd_code_root/core/context_learning_host_ack.py" "$ENGINE" \
        >/dev/null 2>&1 || true
      _laya_notice="$(python3 "$_qmd_code_root/core/laya_index_host_route.py" onboarding-notice \
        "$_laya_route_payload" "$_laya_route_fallback" 2>/dev/null)" || _laya_notice=""
      if [ -n "$_laya_notice" ]; then
        if [ "$ENGINE" = codex ]; then
          # Codex reads SessionStart stdout as one event-shaped JSON object.
          printf '%s' "$_laya_notice" | python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":sys.stdin.read()}},ensure_ascii=False))'
        else
          printf '%s\n' "$_laya_notice"
        fi
      fi
    fi
    exit 0
    ;;
  candidate|preview|worktree)
    # worktree (linked git worktree of a selected main checkout) serves a
    # published generation read-only.
    # Replace this shell with the synchronous writer/query process. A host
    # timeout then kills the work itself, not a waiting shell with an
    # orphaned Python child. The open stdin fd survives unlinking.
    exec <"$_laya_route_payload"
    rm -f "$_laya_route_payload" || { echo '[memvane] route payload cleanup failed' >&2; exit 3; }
    trap - EXIT
    exec python3 "$_qmd_code_root/core/laya_host_response.py" serve-stdin \
      "$ACTION" "$ENGINE" "$_laya_route_fallback"
    ;;
  blocked)
    echo '[memvane] selected route unavailable; request refused' >&2
    exit 3
    ;;
  *) echo '[memvane] route lookup failed; request refused' >&2; exit 3 ;;
esac
