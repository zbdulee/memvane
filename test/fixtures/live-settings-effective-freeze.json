{
  "ai-proxy.json": {
    "allowRoots": [],
    "collectionPaths": {
      "ai-proxy-docs": "docs",
      "ai-proxy-wiki": ".auto-context/wiki"
    },
    "collectionRoles": {
      "ai-proxy-docs": "raw",
      "ai-proxy-wiki": "wiki"
    },
    "collections": [
      "ai-proxy-docs",
      "ai-proxy-wiki"
    ],
    "compile": {
      "batch": {
        "idleSeconds": 90,
        "maxItems": 5
      },
      "budget": {
        "cardsPerSource": 10,
        "dedupPairsPerCompile": 1,
        "dedupPairsPerScan": 8,
        "extractorPerRun": 10,
        "verifyPerRun": 3
      },
      "defaultStatus": "generated",
      "excludeStatusesFromRecall": [
        "discarded",
        "contested"
      ],
      "extractor": {
        "backends": {},
        "builtins": [
          "claude",
          "codex",
          "hermes"
        ],
        "cooldownSeconds": 600,
        "timeout": 120
      },
      "lowPriorityStatuses": [
        "generated",
        "tentative"
      ],
      "maxAutoPageLines": 120,
      "maxSourceChars": 12000,
      "mode": "auto-wiki",
      "reasoningEffort": {
        "engines": {},
        "generation": "low",
        "semanticDedup": "medium",
        "verify": "medium"
      },
      "recallVerifiedOnly": true,
      "semanticDedup": {
        "candidateMinScore": 0.3,
        "enabled": true,
        "judge": {
          "cooldownSeconds": 600,
          "crossEngine": "prefer",
          "enabled": true,
          "maxCharsPerPage": 6000,
          "timeout": 120
        },
        "maxPairsPerScan": 10
      },
      "sourceScan": {
        "enabled": true,
        "maxCardsPerScan": 300
      },
      "triggers": [
        "post_tool_source",
        "manual"
      ],
      "verify": {
        "builtins": [],
        "cooldownSeconds": 600,
        "crossEngine": "prefer",
        "enabled": true,
        "onFail": "delete",
        "onInconclusive": "delete",
        "timeout": 120
      }
    },
    "events": [
      "sessionStart",
      "userPromptSubmit",
      "postToolUse"
    ],
    "indexing": true,
    "injectSourcePathsPerCard": 3,
    "injectSummaryMaxChars": 600,
    "lexicalPatterns": [],
    "maintenance": {
      "orphanVectors": {
        "cooldownSeconds": 86400,
        "enabled": true,
        "minCount": 200,
        "minRatio": 0.2
      }
    },
    "minScore": 0.5,
    "name": "ai-proxy",
    "prefixStyle": "tag",
    "queryTimeout": 3,
    "rawFallbackMinScore": 0.5,
    "recallStrategy": "hierarchical",
    "sessionStartSync": true,
    "skipPaths": [],
    "staleQueueThreshold": 20,
    "topN": 3,
    "wikiPath": ".auto-context/wiki"
  },
